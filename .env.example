# ============================================================
# AIFreeMind Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All model strings follow LiteLLM conventions:
#   https://docs.litellm.ai/docs/providers
# ============================================================

# --- Primary Chat Model ---
# The model used for conversation. Any LiteLLM-compatible string.
# Examples:
#   gemini/gemini-2.0-flash
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-20250514
#   ollama/llama3
#   openrouter/google/gemini-2.0-flash-001
PRIMARY_MODEL=gemini/gemini-2.0-flash

# Optional custom API base for the PRIMARY model (e.g. local Ollama):
# PRIMARY_API_BASE=http://localhost:11434
# API_BASE=http://localhost:11434   # alias for PRIMARY_API_BASE

# --- API Keys ---
# Set the key for whichever provider your PRIMARY_MODEL uses.
# LiteLLM reads these automatically by name.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Fallback Model (optional) ---
# Used if the primary model fails (network error, rate limit, etc.)
# Leave blank to disable fallback.
FALLBACK_MODEL=ollama/llama3
FALLBACK_API_BASE=http://localhost:11434

# --- Reflection Model (optional) ---
# Model used for the end-of-session "mega-prompt" that extracts
# memories and generates the inbox question.
# Defaults to PRIMARY_MODEL if blank. Can use a cheaper model.
REFLECT_MODEL=

# --- Memory Retrieval Settings ---
# Dual retrieval: recent context + semantically relevant memories
MEMORY_RECENT_K=25
MEMORY_RELEVANT_K=15
# Minimum similarity score (0.0 - 1.0) for relevant memories.
MEMORY_RELEVANCE_THRESHOLD=0.7
# Soft boost added to similarity when preferred_domain matches (0.0–0.2 typical)
MEMORY_DOMAIN_BOOST=0.05

# --- Checkpoint Settings ---
# How many exchange pairs (user + assistant) between transcript saves.
CHECKPOINT_INTERVAL=10

# --- Tool Safety ---
# auto = read-only shell auto-runs; writes and unsafe shell ask for confirm
# ask  = always ask before mutating tools (write_file, unsafe run_command)
# deny = refuse all mutating tools
TOOL_PERMISSION_MODE=ask
# Workspace jail for read_file / write_file (default: project root)
# WORKSPACE_ROOT=
# Allow paths outside WORKSPACE_ROOT (default false)
TOOL_ALLOW_OUTSIDE_WORKSPACE=false

# --- Context Window ---
CONTEXT_MAX_MESSAGES=40
CONTEXT_MAX_CHARS=80000

# --- Streaming ---
# Stream replies when the provider supports it (tool schemas stay offered;
# tool_call fragments are accumulated). Falls back to non-stream on failure.
STREAM_RESPONSES=true
